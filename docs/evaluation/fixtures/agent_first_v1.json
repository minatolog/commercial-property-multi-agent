      "without_scenarios": "恰好一个运行项 (case_id, null)，使用 variant.events 执行一次",
      "empty_array": "validation_error: EMPTY_SCENARIOS"
    },
    "resolution": {
      "case_scenario": "在 case.scenarios 数组中按 scenario_id 精确匹配唯一元素，供评测器读取 assertions 与 expected_*",
      "fixture_scenario": "在 variant_registry[case.variant].scenarios 映射中按同一 scenario_id 取场景，供运行器读取 events 与 evidence_requirement",
      "events": "取 fixture_scenario.events 整个数组，替换 variant.events，不做合并",
      "evidence": "若 fixture_scenario 提供 evidence_requirement，则以它为权威并覆盖 case.required_evidence_ids；若未提供，则沿用 case.required_evidence_ids。case 场景若显式写出 required_evidence_ids / evidence_policy，必须与之一致",
      "assertions": "case 场景 assertions 与 case 级 assertions 对该运行项都生效；case 级断言对每个运行项各判一次",
      "overlay": "先应用 variant.overlay 得到数据，再取事件；事件不改数据"
    },
    "no_scenario_case": {
      "events": "variant_registry[variant].events（可为空数组）",
      "default_scenario": "仅当无场景 case 引用的 variant 同时声明了 scenarios 时，必须提供 default_scenario；缺失或未知即 validation_error",
      "assertions": "只使用 case 级 assertions 与 expected_*，恰好执行一次"
    },
    "errors": {
      "MISSING_SCENARIO_ID": "场景对象缺少 scenario_id，或不是非空字符串",
      "DUPLICATE_SCENARIO_ID": "同一 case 的 scenarios 中 scenario_id 重复",
      "UNKNOWN_SCENARIO_ID": "case 场景的 scenario_id 在所引用 variant.scenarios 中不存在",
      "EMPTY_SCENARIOS": "scenarios 存在但为空数组；无场景 case 必须省略该字段",
      "SCENARIOS_NOT_ARRAY": "scenarios 不是数组",
      "DEFAULT_SCENARIO_MISSING": "无场景 case 引用了含 scenarios 的 variant，但 variant 没有 default_scenario",
      "DEFAULT_SCENARIO_UNKNOWN": "variant.default_scenario 不在该 variant 的 scenarios 中",
      "SCENARIO_MISMATCH": "case 场景与 fixture 场景在 fault / evidence / terminal / assertions 上不一致"
    },
    "events_mode": "replace",
    "order": "先按评测计划 §2.3 应用 overlay 得到数据，再加载选中场景的 events；events 不改数据",
    "fault_semantics": "fail_attempts 表示该工具在场景内前 N 次调用返回 mode 故障；尝试序号从 1 开始；超过 N 次后按 then 处理；N 必须 ≤ scenario.tool_max_attempts，否则校验失败",
    "consistency_rule": "对每个有场景的 case：case 场景的 fault_injection.event_id/tool/mode/fail_attempts/then 必须等于 fixture events 中同 event_id 的事件；expected_terminal_outcomes（或 expected_terminal_status）与 fixture 场景一致；evidence_policy 与 evidence_requirement.mode 一致；required_evidence_ids 与 evidence_requirement.required_evidence_ids 相同；任一项不一致即 SCENARIO_MISMATCH",
    "replay_delivery_rule": "重复投递由 delivery.duplicates（event_id + deliveries 次数）表达；事件对象本身逐字段不变，禁止加入 replayed 之类会改变内容哈希的字段"
