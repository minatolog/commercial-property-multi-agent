# 环境变量模板（只含键名，不含任何真实值）
#
# 用法（两种都有效，按需选一种）：
#   1) 复制为 .env 后直接填值 —— CLI（python -m app.cli ...）与 API（uvicorn）
#      启动时都会自动读取仓库根目录或 backend/ 下的 .env；
#   2) 或者不建 .env，直接在终端里导出同名环境变量。
#
# 优先级：**已存在的环境变量优先**，.env 只补空缺，不会覆盖系统里已设置的值。
# 安全：.env 已被 .gitignore 忽略；密钥绝不要写进代码、YAML、文档、日志或测试输出。

# ---------------------------------------------------------------------------
# 模型（可选）
# 未设置时项目仍可离线运行：ask/evaluate 使用 Fake、无真实模型调用。
# 填在这里之后，可跑：
#   python -m app.cli investigate --model-provider deepseek
#   python -m app.cli evaluate --baseline C_multi_agent --model-provider deepseek
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# 演示 API（可选，仅本地演示）
# 身份由服务端注入；请求不能自报 principal 或权限。
# ---------------------------------------------------------------------------
DEMO_PRINCIPAL_ID=principal_ops_xinghui
DEMO_APPROVERS=principal_property_manager_xinghui,principal_finance_xinghui
DEMO_HOST=127.0.0.1
DEMO_PORT=8000

# ---------------------------------------------------------------------------
# 合成文档生成（可选）
# ---------------------------------------------------------------------------
CONTRACT_PDF_OUT=docs/evaluation/documents/lease_xh_a301_contract_v1.pdf
DOC_OUT_DIR=docs/evaluation/documents
