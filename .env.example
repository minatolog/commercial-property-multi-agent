# 环境变量模板（只含键名，不含任何真实值）
# 用法：复制为 .env（.env 已被 .gitignore 忽略）或直接 export

# ---------------------------------------------------------------------------
# 模型（可选）
# 未设置时项目仍可离线运行：ask/evaluate 使用 Fake、无真实模型调用。
# 绝不把密钥写进代码、YAML、文档、日志或测试输出。
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# 演示 API（可选，仅本地演示）
# 身份由服务端注入；请求不能自报 principal 或权限。
# ---------------------------------------------------------------------------
DEMO_PRINCIPAL_ID=principal_ops_xinghui
DEMO_APPROVERS=principal_property_manager_xinghui,principal_finance_xinghui
DEMO_HOST=127.0.0.1
DEMO_PORT=8000

# ---------------------------------------------------------------------------
# 合成文档生成（可选）
# ---------------------------------------------------------------------------
CONTRACT_PDF_OUT=docs/evaluation/documents/lease_xh_a301_contract_v1.pdf
DOC_OUT_DIR=docs/evaluation/documents
